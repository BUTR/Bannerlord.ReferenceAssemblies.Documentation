{
  "build": {
    "xref": [
      "https://learn.microsoft.com/en-us/dotnet/.xrefmap.json",
      "xrefs/Newtonsoft.Json-xrefmap.yml"
    ],
    "content": [
      {
        "files": [ "**/*.{md,yml}" ],
        "exclude": [ "_site/**", "obj/**", "_template/**", "xrefs/**", "index.template.md" ]
      }
    ],
    "resource": [
      {
        "files": [ "**/images/**" ],
        "exclude": [ "_site/**", "obj/**", "_template/**" ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_enableSearch": true,
      "_appTitle": "Unofficial Bannerlord API Documentation",
      "_appName": "Bannerlord API",
      "_appFooter": "© 2020-present Bannerlord's Unofficial Tools & Resources"
    },
    "template": [
      "default",
      "modern",
      "_template/last-modified",
      "_template/my-template"
    ],
    "postProcessors": [
      "ExtractSearchIndex",
      "LastModifiedPostProcessor"
    ]
  }
}
